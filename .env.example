# ==============================================================================
# AI Video & Meeting Assistant - Environment Configuration
# ==============================================================================

# ---- LLM & AI Services ----
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2
SARVAM_MAX_WORKERS=4

# ---- Transcription & Audio ----
WHISPER_MODEL=base
AUDIO_CHUNK_MINUTES=10
TRANSCRIPT_CHUNK_SIZE=1200
TRANSCRIPT_CHUNK_OVERLAP=150

# ---- RAG & Vector Database ----
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

# ---- Authentication & Security ----
# Dual-Mode Authentication:
# 1. Supabase Mode: Set SUPABASE_URL and SUPABASE_ANON_KEY to enable cloud auth,
#    email verification, password reset emails, and Supabase OAuth.
# 2. Local Cryptographic Mode: If Supabase keys are left empty, the application
#    automatically runs on its local bcrypt-encrypted, SQLite-backed auth engine
#    with zero external dependencies.
REQUIRE_AUTH=true
AUTH_SECRET_KEY=generate_a_random_32_char_secret_key_here

# Optional: Supabase Credentials (from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application Logging ----
LOG_LEVEL=INFO
